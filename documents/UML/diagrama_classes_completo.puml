@startuml cultiva_complete_architecture
top to bottom direction

skinparam monochrome false
skinparam shadowing false
skinparam roundcorner 0
skinparam classFontSize 11
skinparam classFontName "Helvetica, Arial, sans-serif"
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam defaultTextAlignment left
skinparam arrowColor #334155
skinparam classBorderColor #475569
skinparam packageBorderColor #64748B
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 55

hide empty members
hide circle

package "Shared / Observer" {
    interface EventObserverInterface <<interface>> {
        + update(event: object): void
    }

    interface EventSubjectInterface <<interface>> {
        + attach(eventClass: string, observerClass: string): void
        + detachAll(eventClass: string): void
        + notify(event: object): void
    }

    class LaravelEventSubject <<Observer Subject>> implements EventSubjectInterface {
        + attach(eventClass: string, observerClass: string): void
        + detachAll(eventClass: string): void
        + notify(event: object): void
    }

    class AppServiceProvider <<ServiceProvider>> {
        + register(): void
        + boot(eventSubject: EventSubjectInterface): void
    }

    class Cep <<Value Object>> {
        - value: string
        --
        + __construct(value: string)
        + value(): string
        + format(): string
    }
}

package "Integrations" {
    package "Geo" {
        interface GeoProviderContract <<interface>> {
            + searchByCep(cep: Cep): GeoAddressDTO
        }

        class BrasilApiGeoProvider implements GeoProviderContract {
            + searchByCep(cep: Cep): GeoAddressDTO
        }

        abstract class GeoProviderFactoryMethod <<Factory Method>> {
            + searchByCep(cep: Cep): GeoAddressDTO
            # {abstract} createProvider(): GeoProviderContract
        }

        class BrasilApiGeoProviderFactoryMethod extends GeoProviderFactoryMethod {
            # createProvider(): GeoProviderContract
        }

        class ResolveGeoProviderAction <<Factory Action>> {
            + execute(): GeoProviderFactoryMethod
        }

        class SearchCepAction <<Action>> {
            + execute(cep: Cep): GeoAddressDTO
        }
    }

    package "ProductSource" {
        class ProductSourceClient <<HTTP Client>> {
            + getProduct(sourceProductId: string): Response
        }

        class GetProductAction <<Action>> {
            + execute(sourceProductId: string): ProductDTO
        }
    }

    package "DocumentValidation" {
        class GeminiDocumentClient <<AI Client>> {
            + validateRg(base64Content: string, mimeType: string): array
        }

        class ValidateRgDocumentAction <<Action>> {
            + execute(base64Content: string, mimeType: string): DocumentValidationResultDTO
        }
    }

    package "ProductImage" {
        class ProductImageClient <<HTTP Client>> {
            + searchAndDownload(query: string): ?string
        }
    }

    package "GoLog" {
        enum GoLogOperationType <<enum>>
        enum GoLogShipmentStatus <<enum>>
        enum GoLogWebhookEventType <<enum>>
        enum GoLogTransportType <<enum>>
        enum GoLogVehicleType <<enum>>

        class GoLogClient <<HTTP Client>> {
            + getAuthSession(): GoLogAuthResponseDTO
            + getToken(): string
            + getCompanyId(): string
            + login(): GoLogAuthResponseDTO
            + getTransportTypes(): array
            + createTransportType(name: string, description: string, care: string): GoLogTransportTypeResponseDTO
            + createUser(name, email, password, cpf, profile): GoLogUserResponseDTO
            + createDriver(userId, cnhNumber, cnhExpiration, costPerHour): GoLogDriverResponseDTO
            + createTractor(plate, renavam, model, ..., ?kmPerLiter): GoLogTractorResponseDTO
            + listEquipamentGroups(): array
            + createEquipamentGroup(equipament1Id: string, ?observation: string = null): GoLogEquipamentGroupResponseDTO
            + createWorkSchedule(driverId, equipamentGroupId, scheduleDate, ...): GoLogWorkScheduleResponseDTO
            + listActiveWorkSchedules(): array
            + importInvoicesJson(invoices: array): GoLogInvoiceImportResponseDTO
            + optimizeRoutes(shipmentIds, workScheduleIds, routePriority): GoLogOptimizeRoutesResponseDTO
            + configureWebhook(webhookUrl: string, webhookSecret: string, webhookActive: bool = true): void
            + testWebhook(): GoLogWebhookTestResponseDTO
            + listShipmentsByStatus(status: GoLogShipmentStatus): array
            + getShipment(shipmentId: string): GoLogShipmentStatusResponseDTO
        }

        class CreateGoLogUserAction <<Action>> {
            + execute(dto: CreateGoLogUserDTO): ProfileResultDTO
        }

        class CreateGoLogDriverAction <<Action>> {
            + execute(driver: GoLogDriver, dto: CreateGoLogDriverDTO): GoLogDriver
        }

        class CreateGoLogVehicleAction <<Action>> {
            + execute(driver: GoLogDriver, dto: CreateGoLogVehicleDTO): GoLogDriver
        }

        class CreateGoLogEquipamentGroupAction <<Action>> {
            + execute(driver: GoLogDriver, dto: CreateGoLogEquipamentGroupDTO): GoLogDriver
        }

        class CreateGoLogWorkScheduleAction <<Action>> {
            + execute(driver: GoLogDriver, dto: CreateGoLogWorkScheduleDTO): GoLogDriver
        }

        class DispatchDeliveryOrdersBatchAction <<Action / CLI>> {
            + execute(): DispatchBatchResultDTO
        }

        class OptimizeDeliveryRoutesAction <<Action / CLI>> {
            + execute(): OptimizeRoutesResultDTO
        }

        class ResolveAvailableWorkSchedulesAction <<Action>> {
            + execute(): AvailableWorkSchedulesDTO
        }

        class ResolveTransportTypeAction <<Action>> {
            + execute(category: CategoryEnum): GoLogTransportType
        }

        class PopulateTransportTypesAction <<Action / CLI>> {
            + execute(): array
        }

        class ReceiveGoLogWebhookAction <<Action>> {
            + execute(deliveryId: string, eventType: GoLogWebhookEventType, payload: array): GoLogWebhookEvent
        }

        class HandleGoLogWebhookAction <<Action>> {
            + execute(event: GoLogWebhookEvent): void
        }

        class SyncGoLogShipmentStatusAction <<Action>> {
            + execute(shipment: GoLogShipment, nextStatus: GoLogShipmentStatus, ...): bool
        }

        class ReconcileGoLogShipmentsAction <<Action / CLI>> {
            + execute(): int
        }

        class ConfigureGoLogWebhookAction <<Action / CLI>> {
            + execute(url: string, ?secret: string = null, active: bool = true, sendTest: bool = false): ?GoLogWebhookTestResponseDTO
        }
    }
}

package "Auth & Registration" {
    enum DocumentValidationStatus <<enum>>

    class SignUpFacade <<Facade>> {
        + register(dto: SignUpDTO): ProfileResultDTO
    }

    class SignUpAction <<Action>> {
        + execute(dto: SignUpDTO): ProfileResultDTO
    }

    class LoginAction <<Action>> {
        + execute(dto: LoginDTO): ProfileResultDTO
    }

    class GenerateTokenPairAction <<Action>> {
        + execute(user: User): AuthTokensDTO
    }

    class GetAuthenticatedProfileAction <<Action>> {
        + execute(user: User): ProfileResultDTO
    }

    class GetSignupMetadataAction <<Action>> {
        + execute(): SignupMetadataDTO
    }

    class UploadDocumentAction <<Action>> {
        + execute(dto: UploadDocumentDTO): User
    }

    class GetDocumentValidationStatusAction <<Action>> {
        + execute(user: User): DocumentValidationStatusDTO
    }

    class SignupStrategyFactory <<Factory>> {
        + make(profileType: ProfileType): SignupStrategyInterface
    }

    interface SignupStrategyInterface <<Strategy>> {
        + registerProfile(user: User, company: Company, dto: SignUpDTO): Model
    }

    class ProducerSignupStrategy implements SignupStrategyInterface {
        + registerProfile(user: User, company: Company, dto: SignUpDTO): Model
    }

    class RetailerSignupStrategy implements SignupStrategyInterface {
        + registerProfile(user: User, company: Company, dto: SignUpDTO): Model
    }

    class DeliverySignupStrategy implements SignupStrategyInterface {
        + registerProfile(user: User, company: Company, dto: SignUpDTO): Model
    }

    interface SignupRuleBuilderInterface <<Builder>> {
        + addUserRules(): static
        + addCompanyRules(): static
        + addAddressRules(prefix: string): static
        + addProducerRules(): static
        + addRetailerRules(): static
        + addDeliveryRules(): static
        + getRules(): array
    }

    class SignupRuleBuilder implements SignupRuleBuilderInterface {
        + addUserRules(): static
        + addCompanyRules(): static
        + addAddressRules(prefix: string): static
        + addProducerRules(): static
        + addRetailerRules(): static
        + addDeliveryRules(): static
        + getRules(): array
    }

    class ProducerSignupDirector <<Director>> {
        + build(): array
    }

    class RetailerSignupDirector <<Director>> {
        + build(): array
    }

    class DeliverySignupDirector <<Director>> {
        + build(): array
    }
}

package "Identity & Profiles" {
    enum ProfileType <<enum>>
    enum ActivitySegment <<enum>>
    enum BusinessType <<enum>>

    class User <<Entity>> {
        - id: int
        - name: string
        - email: string
        - profile_type: ProfileType
        - is_active: bool
        - is_verified: bool
        - last_login: ?DateTime
        - email_verified_at: ?DateTime
        --
        + isRetailer(): bool
        + isProducer(): bool
        + isDelivery(): bool
        + isGoLogDriver(): bool
        + markAsVerified(): void
    }

    class Company <<Entity>> {
        - id: int
        - user_id: int
        - document_number: string
        - trade_name: string
        - legal_name: ?string
        - phone: string
    }

    class Address <<Entity>> {
        - id: int
        - company_id: int
        - zip: string
        - street: string
        - number: string
        - complement: ?string
        - reference_point: ?string
        - neighborhood: string
        - city: string
        - state: string
        - coordinate: ?Point
    }

    class Producer <<Entity>> {
        - id: int
        - company_id: int
        - activity_segment: ActivitySegment
    }

    class Retailer <<Entity>> {
        - id: int
        - company_id: int
        - business_type: BusinessType
    }

    class CreateUserAction <<Action>> {
        + execute(dto: UserRegisterDTO): User
    }

    class CreateCompanyAction <<Action>> {
        + execute(userId: int, dto: CompanyRegisterDTO, geo: GeoAddressDTO): Company
    }

    class CreateAddressAction <<Action>> {
        + execute(company: Company, dto: AddressRegisterDTO, geo: GeoAddressDTO): Address
    }

    class CreateProducerAction <<Action>> {
        + execute(companyId: int, dto: ProducerRegisterDTO): Producer
    }

    class CreateRetailerAction <<Action>> {
        + execute(companyId: int, dto: RetailerRegisterDTO): Retailer
    }

    class VerifyUserDocumentAction <<Action>> {
        + execute(user: User, filePath: string, mimeType: string): User
    }
}

package "Logistics & Fleet" {
    enum CnhCategory <<enum>>
    enum "CargoType" as CargoTypeEnum <<enum>>
    enum GoLogDriverStep <<enum>>

    class CargoType <<Entity>> {
        - id: int
        - code: CargoTypeEnum
    }

    class Delivery <<Entity>> {
        - id: int
        - company_id: int
        - cnh_number: string
        - cnh_category: CnhCategory
    }

    class Vehicle <<Entity>> {
        - id: int
        - delivery_id: int
        - cargo_type_id: int
        - plate: string
        - capacity: float
    }

    class GoLogDriver <<Entity>> {
        - id: int
        - company_id: int
        - cpf: string
        - golog_user_id: ?string
        - golog_driver_id: ?string
        --
        + getStoppedStep(): GoLogDriverStep
        + isProvisioned(): bool
    }

    class GoLogVehicle <<Entity>> {
        - id: int
        - golog_driver_id: int
        - golog_tractor_id: ?string
        - golog_equipament_group_id: ?string
    }

    class CreateDeliveryAction <<Action>> {
        + execute(companyId: int, dto: DeliveryRegisterDTO): Delivery
    }

    class CreateVehicleAction <<Action>> {
        + execute(deliveryId: int, dto: VehicleRegisterDTO): Vehicle
    }
}

package "Commerce & Wishlist" {
    class Purchase <<Entity>> {
        - id: int
        - offer_id: int
        - retailer_id: int
        - producer_id: int
        - source_product_id: string
        - product_name: string
        - quantity: int
        - unit_price: decimal
        - total_price: decimal
    }

    class WishlistItem <<Entity>> {
        - id: int
        - retailer_id: int
        - source_product_id: string
        - product_name: string
        - state: string
    }

    class PurchaseCreated <<Event>> {
        + purchase: Purchase
    }

    class CreatePurchaseAction <<Action>> {
        + execute(retailer: Retailer, offerId: int, data: CreatePurchaseDTO): Purchase
    }

    class ListRetailerPurchasesAction <<Action>> {
        + execute(retailer: Retailer, page: int, perPage: int, ?search: string = null): LengthAwarePaginator
    }

    class ListProducerSalesAction <<Action>> {
        + execute(producer: Producer, page: int, perPage: int, ?search: string = null): LengthAwarePaginator
    }

    class AddWishlistItemAction <<Action>> {
        + execute(retailer: Retailer, dto: AddWishlistItemDTO): WishlistItem
    }

    class ListWishlistItemsAction <<Action>> {
        + execute(retailer: Retailer, dto: ListWishlistItemsDTO): LengthAwarePaginator
    }

    class RemoveWishlistItemAction <<Action>> {
        + execute(retailer: Retailer, wishlistItemId: int): void
    }

    class GetWishlistAnalyticsAction <<Action>> {
        + execute(user: User, dto: GetWishlistAnalyticsDTO): WishlistAnalyticsDTO
    }
}

package "Catalog & Marketplace" {
    enum OfferStatus <<enum>>
    enum "Category" as CategoryEnum <<enum>>

    class Category <<Entity>> {
        - id: int
        - name: CategoryEnum
    }

    class Offer <<Entity>> {
        - id: int
        - producer_id: int
        - category_id: int
        - source_product_id: string
        - product_name: string
        - unit_price: decimal
        - total_quantity: int
        - reserved_quantity: int
        - status: OfferStatus
        - harvest_date: Date
        - lifespan_days: int
        - image_path: ?string
        --
        + availableQuantity(): int
        + isVisible(): bool
    }

    class HarvestForecast <<Entity>> {
        - id: int
        - producer_id: int
        - source_product_id: string
        - product_name: string
        - quantity: int
        - start_date: Date
        - end_date: Date
    }

    class CreateOfferAction <<Action>> {
        + execute(producer: Producer, data: CreateOfferDTO): Offer
    }

    class UpdateOfferAction <<Action>> {
        + execute(producer: Producer, offerId: int, data: UpdateOfferDTO): Offer
    }

    class ListOffersAction <<Action>> {
        + execute(user: User, page: int, perPage: int, ?search: string = null): LengthAwarePaginator
    }

    class ListProducerOffersAction <<Action>> {
        + execute(producer: Producer, page: int, perPage: int, ?search: string = null): LengthAwarePaginator
    }

    class ListAvailableOffersAction <<Action>> {
        + execute(user: User, page: int, perPage: int, ?search: string = null): LengthAwarePaginator
    }

    class GetOfferAction <<Action>> {
        + execute(user: User, offerId: int): Offer
    }

    class GetProducerOfferAction <<Action>> {
        + execute(producer: Producer, offerId: int): Offer
    }

    class GetAvailableOfferAction <<Action>> {
        + execute(offerId: int): Offer
    }

    class ListCategoriesAction <<Action>> {
        + execute(): Collection
    }

    class PopulateProductImageAction <<Action / CLI>> {
        + execute(sourceProductId: string, ?productName: string = null): string
    }

    class CreateHarvestForecastAction <<Action>> {
        + execute(producer: Producer, data: CreateHarvestForecastDTO): HarvestForecast
    }

    class UpdateHarvestForecastAction <<Action>> {
        + execute(producer: Producer, forecastId: int, data: UpdateHarvestForecastDTO): HarvestForecast
    }

    class DeleteHarvestForecastAction <<Action>> {
        + execute(producer: Producer, forecastId: int): void
    }

    class ListHarvestForecastsAction <<Action>> {
        + execute(data: ListHarvestForecastsDTO): LengthAwarePaginator
    }

    class ListHarvestSeasonPeriodsAction <<Action>> {
        + execute(sourceProductId: string): Collection
    }
}

package "Delivery & Fulfillment" {
    enum DeliveryTripStatus <<enum>>
    enum DeliveryTripStopStatus <<enum>>
    enum DeliveryTripStopType <<enum>>
    enum DeliveryOrderStatus <<enum>>

    class DeliveryTrip <<Entity>> {
        - id: int
        - delivery_id: ?int
        - vehicle_id: ?int
        - cargo_type_id: int
        - status: DeliveryTripStatus
        - started_at: ?DateTime
        - completed_at: ?DateTime
        - cancelled_at: ?DateTime
    }

    class DeliveryTripStop <<Entity>> {
        - id: int
        - trip_id: int
        - delivery_address_id: int
        - sequence: int
        - stop_type: DeliveryTripStopType
        - status: DeliveryTripStopStatus
        - arrived_at: ?DateTime
        - completed_at: ?DateTime
        - notes: ?string
    }

    class DeliveryOrder <<Entity>> {
        - id: int
        - purchase_id: int
        - trip_id: ?int
        - pickup_stop_id: ?int
        - dropoff_stop_id: ?int
        - pickup_address_id: int
        - dropoff_address_id: int
        - quantity: int
        - status: DeliveryOrderStatus
        - picked_up_at: ?DateTime
        - delivered_at: ?DateTime
        - failed_at: ?DateTime
        - cancelled_at: ?DateTime
    }

    class DeliveryAddress <<Entity>> {
        - id: int
        - zip: string
        - street: string
        - number: string
        - complement: ?string
        - reference_point: ?string
        - neighborhood: string
        - city: string
        - state: string
        - coordinate: ?Point
    }

    class GoLogShipment <<Entity>> {
        - id: int
        - delivery_order_id: int
        - golog_shipment_id: string
        - type: GoLogOperationType
        - status: GoLogShipmentStatus
    }

    class GoLogWebhookEvent <<Entity>> {
        - id: int
        - delivery_id: string
        - event: GoLogWebhookEventType
        - golog_shipment_id: ?string
        - occurrence_id: ?string
        - occurrence_type: ?string
        - description: ?string
        - occurred_at: ?DateTime
        - payload: array
        - processed_at: ?DateTime
    }

    class CreateDeliveryOrderListener <<Listener>> {
        + update(event: object): void
        + handle(event: PurchaseCreated): void
    }

    class CreateDeliveryOrderAction <<Action>> {
        + execute(purchase: Purchase): DeliveryOrder
    }

    class ListAvailableTripsAction <<Action>> {
        + execute(delivery: Delivery, page: int = 1, perPage: int = 15): LengthAwarePaginator
    }

    class ListFinishedTripsAction <<Action>> {
        + execute(delivery: Delivery, page: int = 1, perPage: int = 15): LengthAwarePaginator
    }

    class GetCurrentTripAction <<Action>> {
        + execute(delivery: Delivery): ?DeliveryTrip
    }

    class AssignTripAction <<Action>> {
        + execute(delivery: Delivery, tripId: int): DeliveryTrip
    }

    class CancelTripAssignmentAction <<Action>> {
        + execute(delivery: Delivery, tripId: int): DeliveryTrip
    }

    class ConfirmTripStopAction <<Action>> {
        + execute(delivery: Delivery, stopId: int): DeliveryTripStop
    }
}

' Observer & Shared Infrastructure wirings
AppServiceProvider ..> EventSubjectInterface : binds & boots
AppServiceProvider ..> LaravelEventSubject : binds
AppServiceProvider ..> PurchaseCreated : attaches
AppServiceProvider ..> CreateDeliveryOrderListener : attaches
CreateDeliveryOrderListener ..|> EventObserverInterface

' Integration & Factory Method wirings
BrasilApiGeoProviderFactoryMethod ..> BrasilApiGeoProvider : creates
ResolveGeoProviderAction ..> GeoProviderFactoryMethod : resolves
ResolveGeoProviderAction ..> BrasilApiGeoProviderFactoryMethod : instantiates
SearchCepAction ..> ResolveGeoProviderAction : resolves via
SearchCepAction ..> GeoProviderFactoryMethod : calls searchByCep()
SearchCepAction ..> Cep : accepts
GeoProviderContract ..> Cep : accepts
GetProductAction o-- ProductSourceClient : calls
ValidateRgDocumentAction o-- GeminiDocumentClient : calls
PopulateProductImageAction o-- ProductImageClient : downloads via
PopulateProductImageAction ..> GetProductAction : fetches name via

' Registration & Auth wirings
SignUpAction ..> SignUpFacade : delegates
SignUpFacade ..> Cep : validates
SignUpFacade ..> SearchCepAction : resolves geo via
SignUpFacade ..> CreateUserAction : delegates
SignUpFacade ..> CreateCompanyAction : delegates
SignUpFacade ..> SignupStrategyFactory : uses
SignUpFacade ..> GenerateTokenPairAction : delegates
CreateCompanyAction ..> CreateAddressAction : delegates

LoginAction ..> User : authenticates
LoginAction ..> GenerateTokenPairAction : delegates
GenerateTokenPairAction ..> User : issues tokens
GetAuthenticatedProfileAction ..> User : wraps
GetSignupMetadataAction ..> ProfileType : reads options
GetSignupMetadataAction ..> ActivitySegment : reads options
GetSignupMetadataAction ..> BusinessType : reads options
GetSignupMetadataAction ..> CnhCategory : reads options
GetSignupMetadataAction ..> CargoTypeEnum : reads options

UploadDocumentAction ..> User : checks verified
UploadDocumentAction ..> DocumentValidationStatus : caches PENDING
UploadDocumentAction ..> VerifyUserDocumentAction : <<async>>
GetDocumentValidationStatusAction ..> User : reads cache for
GetDocumentValidationStatusAction ..> DocumentValidationStatus : returns status
VerifyUserDocumentAction ..> ValidateRgDocumentAction : validates via
VerifyUserDocumentAction ..> User : marks verified
VerifyUserDocumentAction ..> DocumentValidationStatus : caches result

SignupStrategyFactory ..> SignupStrategyInterface : makes
ProducerSignupStrategy ..> CreateProducerAction : delegates
RetailerSignupStrategy ..> CreateRetailerAction : delegates
DeliverySignupStrategy ..> CreateDeliveryAction : delegates
CreateDeliveryAction ..> CreateVehicleAction : delegates

ProducerSignupDirector o-- SignupRuleBuilderInterface : directs
RetailerSignupDirector o-- SignupRuleBuilderInterface : directs
DeliverySignupDirector o-- SignupRuleBuilderInterface : directs

' Domain Model Associations & Cardinalities
User "1" *--down- "1" Company : owns
Company "1" *-- "1" Address : located at
User ..> ProfileType : classified by

Company "1" *-- "0..1" Producer : profile
Company "1" *-- "0..1" Retailer : profile
Company "1" *-- "0..1" Delivery : profile
Company "1" *-- "0..1" GoLogDriver : profile

Producer ..> ActivitySegment
Retailer ..> BusinessType

Delivery ..> CnhCategory
Delivery "1" *-- "1..*" Vehicle : operates
Vehicle "0..*" --> "1" CargoType : classified by
CargoType ..> CargoTypeEnum : typed by
GoLogDriver "1" *-- "0..1" GoLogVehicle : provisions
GoLogDriver ..> GoLogDriverStep : tracks step

Category ..> CategoryEnum : typed by
Category "1" o-- "0..*" Offer : classifies
Producer "1" o-- "0..*" Offer : publishes
Producer "1" o-- "0..*" HarvestForecast : forecasts
Offer ..> OfferStatus

Offer "1" <-- "0..*" Purchase : fulfills
Retailer "1" <-- "0..*" Purchase : places
Producer "1" <-- "0..*" Purchase : fulfills for

Retailer "1" *-- "0..*" WishlistItem : tracks

' Delivery, Fulfillment & GoLog Associations
DeliveryTrip ..> DeliveryTripStatus
DeliveryTripStop ..> DeliveryTripStopStatus
DeliveryTripStop ..> DeliveryTripStopType
DeliveryOrder ..> DeliveryOrderStatus

Purchase "1" *-- "0..1" DeliveryOrder : generates
DeliveryTrip "1" *-- "1..*" DeliveryTripStop : contains
DeliveryTrip "1" *-- "0..*" DeliveryOrder : consolidates
DeliveryTrip "0..*" --> "0..1" Delivery : assigned to
DeliveryTrip "0..*" --> "0..1" Vehicle : uses
DeliveryTrip "0..*" --> "1" CargoType : requires

DeliveryTripStop "0..*" --> "1" DeliveryAddress : located at
DeliveryTripStop "1" o-- "0..*" DeliveryOrder : fulfills
DeliveryOrder "1" *-- "2" DeliveryAddress : addresses
DeliveryOrder "1" *-- "0..2" GoLogShipment : dispatches
GoLogShipment ..> GoLogOperationType
GoLogShipment ..> GoLogShipmentStatus
GoLogWebhookEvent ..> GoLogWebhookEventType

