  <diagram name="Page-1" id="zwrNtaPX5Fti1qxiapzc">
    <mxGraphModel dx="938" dy="557" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="1..1" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam roundcorner 5\nskinparam packageStyle rectangle\nskinparam linetype ortho\nhide circle\n\ntitle Cultiva - Diagrama Preliminar de Classes de Domínio\n\npackage \&quot;Identidade e Organização\&quot; {\n    class User {\n        + name: string\n        + email: string\n        + is_active: bool\n        + profile_type: ProfileType\n        + last_login: DateTime\n        --\n        + isRetailer(): bool\n        + isProducer(): bool\n        + isDelivery(): bool\n    }\n\n    enum ProfileType &lt;&lt;enum&gt;&gt; {\n        PRODUCER\n        RETAILER\n        DELIVERY\n    }\n\n    class Company {\n        + document_number: string\n        + trade_name: string\n        + legal_name: string\n        + phone: string\n    }\n\n    class Address {\n        + zip: string\n        + street: string\n        + number: string\n        + complement: string\n        + neighborhood: string\n        + city: string\n        + state: string\n        + coordinate: Point\n    }\n\n    User \&quot;1\&quot; -right-&gt; \&quot;1\&quot; Company : possui\n    User ..right.. ProfileType\n    Company \&quot;1\&quot; *--right--&gt; \&quot;0..1\&quot; Address\n}\n\npackage \&quot;Produtor e Ofertas\&quot; {\n    class Producer {\n        + activity_segment: ActivitySegment\n    }\n\n    enum ActivitySegment &lt;&lt;enum&gt;&gt; {\n        VEGETABLES\n        FRUITS\n        TUBERS_ROOTS\n        HERBS_SPICES\n        GRAINS\n        SPECIALTY\n    }\n\n    class Category {\n        + name: string\n    }\n\n    class Offer {\n        + source_product_id: string\n        + product_name: string\n        + unit_price: decimal\n        + total_quantity: int\n        + reserved_quantity: int\n        + status: OfferStatus\n        --\n        + availableQuantity(): int\n        + isVisible(): bool\n    }\n\n    enum OfferStatus &lt;&lt;enum&gt;&gt; {\n        ACTIVE\n        INACTIVE\n    }\n\n    Producer .. ActivitySegment\n    Producer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Offer : publica\n    Category \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Offer : categoriza\n    Offer .. OfferStatus\n}\n\npackage \&quot;Varejista e Pedidos (Comércio)\&quot; {\n    class Retailer {\n        + business_type: BusinessType\n    }\n\n    enum BusinessType &lt;&lt;enum&gt;&gt; {\n        SUPERMARKET\n        HORTIFRUTI\n        RESTAURANT\n    }\n\n    class Order {\n        + order_number: string\n        + total_amount: decimal\n        + status: OrderStatus\n    }\n\n    class OrderItem {\n        + quantity: int\n        + unit_price: decimal\n        + subtotal: decimal\n    }\n\n    enum OrderStatus &lt;&lt;enum&gt;&gt; {\n        PENDING\n        CONFIRMED\n        IN_TRANSIT\n        DELIVERED\n        CANCELLED\n    }\n\n    Retailer .. BusinessType\n    Retailer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Order : realiza\n    Order \&quot;1\&quot; *--&gt; \&quot;1..*\&quot; OrderItem : itens\n    Order .. OrderStatus\n}\n\npackage \&quot;Entregador e Frota (Logística)\&quot; {\n    class Delivery {\n        + cnh_number: string\n        + cnh_category: CnhCategory\n    }\n\n    enum CnhCategory &lt;&lt;enum&gt;&gt; {\n        A, B, C, D, E\n        AB, AC, AD, AE\n    }\n\n    class Vehicle {\n        + plate: string\n        + cargo_type: CargoType\n    }\n\n    enum CargoType &lt;&lt;enum&gt;&gt; {\n        DRY\n        CLIMATE_CONTROLLED\n        REFRIGERATED\n    }\n\n    Delivery .. CnhCategory\n    Delivery \&quot;1\&quot; *--&gt; \&quot;1..*\&quot; Vehicle : veículos\n    Vehicle .. CargoType\n}\n\n&#39; Layout alignment\n\&quot;Identidade e Organização\&quot; -[hidden]down-&gt; \&quot;Produtor e Ofertas\&quot;\n\&quot;Identidade e Organização\&quot; -[hidden]down-&gt; \&quot;Varejista e Pedidos (Comércio)\&quot;\n\&quot;Identidade e Organização\&quot; -[hidden]down-&gt; \&quot;Entregador e Frota (Logística)\&quot;\n\n\&quot;Produtor e Ofertas\&quot; -[hidden]right-&gt; \&quot;Varejista e Pedidos (Comércio)\&quot;\n\&quot;Varejista e Pedidos (Comércio)\&quot; -[hidden]right-&gt; \&quot;Entregador e Frota (Logística)\&quot;\n\n&#39; Cross-group connections\nCompany --&gt; Producer\nCompany --&gt; Retailer\nCompany --&gt; Delivery\n\nOrderItem --&gt; Offer : produto\nDelivery --&gt; Order : entrega\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zhT6Ag93mT0eFyN5raES-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
