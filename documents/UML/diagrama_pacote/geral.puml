@startuml geral
skinparam dpi 180
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Inter", "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam nodesep 50
skinparam ranksep 60
skinparam arrowThickness 1.4
skinparam ArrowColor #455A64
skinparam ArrowFontColor #37474F
skinparam ArrowFontSize 10

skinparam folder {
    BorderThickness 1.5
}

' ============================================================================
' PASTAS ABSTRATAS DE DOMÍNIO (MÓDULOS PRINCIPAIS)
' ============================================================================

' Linha Superior (Acesso, Catálogo e Demanda)
folder "<b>Autenticação</b>\n----\nControle Acesso" as Auth #E3F2FD;line:1976D2
folder "<b>Catálogo</b>\n----\nGestão Produtos" as Catalog #E8F5E9;line:2E7D32
folder "<b>Desejos</b>\n----\nAnálise Demanda" as Wishlist #EDE7F6;line:6A1B9A

' Linha Inferior (Operação, Fulfillment e Integração Externa)
folder "<b>Integrações</b>\n----\nServiços Externos" as Integrations #E0F2F1;line:00695C
folder "<b>Logística</b>\n----\nGestão Entregas" as Logistics #FCE4EC;line:C2185B
folder "<b>Compras</b>\n----\nPedidos Vendas" as Purchase #FFF8E1;line:EF6C00

' ============================================================================
' ALINHAMENTO ESTRUTURAL DA GRADE
' ============================================================================
Auth -[hidden]right-> Catalog
Catalog -[hidden]right-> Wishlist

Integrations -[hidden]right-> Logistics
Logistics -[hidden]right-> Purchase

Auth -[hidden]down-> Integrations
Catalog -[hidden]down-> Logistics
Wishlist -[hidden]down-> Purchase

' ============================================================================
' RELAÇÕES DE USO E DEPENDÊNCIA (PADRÃO OFICIAL UML 2.5: <<use>>)
' ============================================================================
Catalog .left.> Auth : <<use>>
Wishlist .left.> Catalog : <<use>>
Auth .down.> Integrations : <<use>>

Purchase .up.> Catalog : <<use>>
Purchase .left.> Logistics : <<use>>
Logistics .left.> Integrations : <<use>>
Purchase .up.> Auth : <<use>>

@enduml
