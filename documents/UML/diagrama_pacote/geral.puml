    package "Offer\Actions" as A_Offer <<Business>> #FEF3C7;line:F59E0B;text:78350F {
    }

    package "Purchase\Actions" as A_Purchase <<Business>> #FEF3C7;line:F59E0B;text:78350F {
    }

    package "Logistics\Actions" as A_Logistics <<Business>> #FEF3C7;line:F59E0B;text:78350F {
