@startuml geral
skinparam shadowing false
skinparam packageStyle folder
skinparam defaultFontName "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif
skinparam defaultFontSize 12
skinparam nodesep 45
skinparam ranksep 75
skinparam arrowThickness 1.5
skinparam ArrowColor #334155
skinparam ArrowFontColor #1E293B
skinparam ArrowFontSize 11

skinparam package {
    FontName "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif
    FontSize 13
    FontStyle bold
    BorderThickness 1.5
    StereotypeFontSize 11
    StereotypeFontColor #475569
}

top to bottom direction

' ============================================================================
' 1. CAMADA DE APRESENTAÇÃO (CONTROLLERS) - Tema Azul
' ============================================================================
package "Camada de Apresentação (Controllers)" as Presentation #EFF6FF;line:2563EB;text:1E3A8A {

    package "Wishlist\Controllers" as C_Wishlist <<REST API>> #DBEAFE;line:3B82F6;text:1E3A8A {
    }

    package "Auth\Controllers" as C_Auth <<REST API>> #DBEAFE;line:3B82F6;text:1E3A8A {
    }

    package "Catalog\Controllers" as C_Catalog <<REST API>> #DBEAFE;line:3B82F6;text:1E3A8A {
    }

    package "Purchase\Controllers" as C_Purchase <<REST API>> #DBEAFE;line:3B82F6;text:1E3A8A {
    }

    package "Logistics\Controllers" as C_Logistics <<REST API>> #DBEAFE;line:3B82F6;text:1E3A8A {
    }

    C_Wishlist -[hidden]right-> C_Auth
    C_Auth -[hidden]right-> C_Catalog
    C_Catalog -[hidden]right-> C_Purchase
