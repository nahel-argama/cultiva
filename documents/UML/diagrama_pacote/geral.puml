    package "Wishlist\Models" as M_Wishlist <<Persistence>> #D1FAE5;line:10B981;text:064E3B {
    }

    package "Identity\Models" as M_Identity <<Persistence>> #D1FAE5;line:10B981;text:064E3B {
    }

    package "Catalog\Models" as M_Catalog <<Persistence>> #D1FAE5;line:10B981;text:064E3B {
    }

    package "Purchase\Models" as M_Purchase <<Persistence>> #D1FAE5;line:10B981;text:064E3B {
    }

    package "Logistics\Models" as M_Logistics <<Persistence>> #D1FAE5;line:10B981;text:064E3B {
