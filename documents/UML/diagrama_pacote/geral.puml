' ============================================================================
' RELAÇÕES DE USO: APRESENTAÇÃO -> NEGÓCIO
' ============================================================================
C_Wishlist ..> A_Wishlist : <<use>>
C_Auth ..> A_Identity : <<use>>
C_Catalog ..> A_Offer : <<use>>
C_Purchase ..> A_Purchase : <<use>>
C_Logistics ..> A_Logistics : <<use>>

' ============================================================================
' RELAÇÕES DE USO ENTRE REGRAS DE NEGÓCIO (ACTIONS -> ACTIONS)
' ============================================================================
A_Wishlist .right.> A_Identity : <<use>>
A_Offer .left.> A_Identity : <<use>>
A_Purchase .left.> A_Offer : <<use>>
A_Purchase .right.> A_Logistics : <<use>>

' ============================================================================
' RELAÇÕES DE USO: NEGÓCIO -> DADOS
' ============================================================================
A_Wishlist ..> M_Wishlist : <<use>>
A_Wishlist ..> M_Identity : <<use>>
A_Identity ..> M_Identity : <<use>>
A_Offer ..> M_Catalog : <<use>>
A_Offer ..> M_Identity : <<use>>
A_Purchase ..> M_Purchase : <<use>>
A_Purchase ..> M_Catalog : <<use>>
A_Logistics ..> M_Logistics : <<use>>
A_Logistics ..> M_Purchase : <<use>>

' ============================================================================
' RELAÇÕES ESTRUTURAIS ENTRE MODELOS DE DADOS (MODELS -> MODELS)
' ============================================================================
M_Wishlist .right.> M_Identity : <<use>>
M_Catalog .left.> M_Identity : <<use>>
M_Purchase .left.> M_Catalog : <<use>>
M_Logistics .left.> M_Purchase : <<use>>

@enduml
