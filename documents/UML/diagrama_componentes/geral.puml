@startuml geral
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif
skinparam defaultFontSize 11
skinparam roundCorner 4
skinparam nodesep 50
skinparam ranksep 70
skinparam arrowThickness 1.3
skinparam ArrowColor #222222
skinparam ArrowFontColor #111111
skinparam ArrowFontSize 10
skinparam linetype ortho
skinparam componentStyle uml2

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #222222
    FontColor #111111
    FontSize 11
    FontStyle bold
    BorderThickness 1.3
}

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #222222
    FontColor #111111
    FontSize 12
    FontStyle bold
    BorderThickness 1.4
}

top to bottom direction

' ============================================================================
' 1. CLIENTE & FRONTEND
' ============================================================================
package "Cliente Web" as ClientPkg {
    component "Frontend SPA" as Comp_Frontend
}

' ============================================================================
' 2. API GATEWAY
' ============================================================================
package "Borda & Roteamento" as EdgePkg {
    component "API Gateway" as Comp_Gateway
}

' ============================================================================
' 3. SUBSISTEMA BACKEND PRINCIPAL
' ============================================================================
package "Subsistema Backend Principal" as BackendPkg {
    component "Lista de Desejos" as Comp_Wishlist
    component "Autenticação & Usuários" as Comp_Auth
    component "Catálogo & Ofertas" as Comp_Offers
    component "Compras & Checkout" as Comp_Purchases
    component "Logística & Frotas" as Comp_Logistics

    component "Módulo de Integrações Externas" as Comp_Integrations
    component "Processador de Filas" as Comp_Worker

    ' Alinhamento horizontal da camada de domínio
    Comp_Wishlist -[hidden]right-> Comp_Auth
    Comp_Auth -[hidden]right-> Comp_Offers
    Comp_Offers -[hidden]right-> Comp_Purchases
    Comp_Purchases -[hidden]right-> Comp_Logistics

    ' Alinhamento vertical interno
    Comp_Auth -[hidden]down-> Comp_Integrations
    Comp_Purchases -[hidden]down-> Comp_Worker

    ' Conexões macho-fêmea internas (orquestração de domínio)
    Comp_Wishlist -right(0- Comp_Auth
    Comp_Offers -left(0- Comp_Auth
    Comp_Purchases -left(0- Comp_Offers
    Comp_Purchases -right(0- Comp_Logistics

    ' Conexões para Integrações e Filas
    Comp_Auth -down(0- Comp_Integrations
    Comp_Offers -down(0- Comp_Integrations
    Comp_Logistics -down(0- Comp_Integrations

    Comp_Purchases -down(0- Comp_Worker
    Comp_Logistics -down(0- Comp_Worker
}

' ============================================================================
' 4. SERVIÇO DE PRODUTOS
' ============================================================================
package "Serviço de Produtos" as ProductPkg {
    component "API de Catálogo de Preços" as Comp_ProductAPI
    component "Mecanismo de Ingestão" as Comp_Scraper
    component "DuckDB" <<database>> as DB_DuckDB

    Comp_Scraper -down(0- DB_DuckDB
    Comp_ProductAPI -down(0- DB_DuckDB
    Comp_Scraper -right(0- Comp_ProductAPI
}

' ============================================================================
' 5. PERSISTÊNCIA & CACHE
' ============================================================================
package "Persistência & Cache" as StoragePkg {
    component "PostgreSQL" <<database>> as DB_Postgres
    component "Redis" <<database>> as DB_Redis

    DB_Redis -[hidden]right-> DB_Postgres
}

' ============================================================================
' 6. PROVEDORES EXTERNOS
' ============================================================================
package "Provedores Externos" as ExternalPkg {
    component "GoLog TMS" as Ext_GoLog
    component "Validador de Documentos" as Ext_DocValidation
    component "BrasilAPI" as Ext_BrasilApi

    Ext_GoLog -[hidden]right-> Ext_DocValidation
    Ext_DocValidation -[hidden]right-> Ext_BrasilApi
}

' ============================================================================
' ALINHAMENTO GLOBAL
' ============================================================================
ProductPkg -[hidden]right-> BackendPkg
ExternalPkg -[hidden]right-> StoragePkg

' ============================================================================
' CONEXÕES ENTRE SUBSISTEMAS E COMPONENTES
' ============================================================================
Comp_Frontend -down(0- Comp_Gateway

Comp_Gateway -left(0- Comp_ProductAPI
Comp_Gateway -down(0- BackendPkg

Comp_Integrations -left(0- Comp_ProductAPI

BackendPkg -down(0- DB_Postgres
BackendPkg -down(0- DB_Redis
Comp_Worker -down(0- DB_Redis

Comp_Integrations -down(0- Ext_BrasilApi
Comp_Integrations -down(0- Ext_GoLog
Comp_Integrations -down(0- Ext_DocValidation

@enduml
