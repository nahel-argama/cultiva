@startuml geral
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif
skinparam defaultFontSize 11
skinparam roundCorner 4
skinparam nodesep 55
skinparam ranksep 75
skinparam arrowThickness 1.3
skinparam ArrowColor #222222
skinparam ArrowFontColor #111111
skinparam ArrowFontSize 10
skinparam linetype ortho

skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #222222
    FontColor #111111
    FontSize 11
    FontStyle bold
    BorderThickness 1.3
}

skinparam component {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontSize 10
}

skinparam database {
    BackgroundColor #FFFFFF
    BorderColor #222222
    FontSize 11
    FontStyle bold
    BorderThickness 1.3
}

skinparam cloud {
    BackgroundColor #FAFAFA
    BorderColor #222222
    FontSize 11
    FontStyle bold
}

top to bottom direction

' ============================================================================
' 1. CLIENTE
' ============================================================================
node "Dispositivo do Usuário" as Client <<device>> {
    component "Navegador Web\n(Frontend SPA)" as Browser
}

' ============================================================================
' 2. GATEWAY & ROTEAMENTO
' ============================================================================
node "Servidor de Entrada" as Gateway <<device>> {
    component "Proxy Reverso & Gateway\n(NGINX)" as Nginx
}

' ============================================================================
' 3. MICROSSERVIÇO DE PRODUTOS (ESQUERDA)
' ============================================================================
node "Servidor de Produtos" as ProductServer <<device>> {
    component "API de Produtos\n(FastAPI / Python)" as ProductApi
    database "DuckDB\n(Base Analítica)" as DuckDB
    ProductApi -down-> DuckDB : Leitura Local
}

' ============================================================================
' 4. APLICAÇÃO PRINCIPAL (CENTRO)
' ============================================================================
node "Servidor da Aplicação Principal" as Backend <<device>> {
    component "API Cultiva\n(Laravel)" as LaravelApi
    component "Worker de Filas\n(Horizon)" as Worker
    
    LaravelApi -[hidden]right-> Worker
}

' ============================================================================
' 5. BANCOS DE DADOS (BASE CENTRAL)
' ============================================================================
node "Banco de Dados Principal" as DbServer <<device>> {
    database "PostgreSQL + PostGIS\n(cultiva_db)" as PostgresDB
}

node "Servidor de Cache e Filas" as RedisServer <<device>> {
    database "Redis\n(Sessões e Fila)" as RedisDB
}

' ============================================================================
' 6. SERVIÇOS EXTERNOS (DIREITA)
' ============================================================================
cloud "Serviços Externos" as ExternalCloud {
    component "BrasilAPI (CEP e Localização)" as BrasilApi
    component "GoLog (Cálculo de Frete)" as GoLogApi
    component "Validação Cadastral (RG/CPF)" as DocApi
    
    BrasilApi -[hidden]down-> GoLogApi
    GoLogApi -[hidden]down-> DocApi
}

' ============================================================================
' ALINHAMENTO ESTRUTURAL
' ============================================================================
Client -[hidden]down-> Gateway
Gateway -[hidden]down-> Backend

ProductServer -[hidden]right-> Backend
Backend -[hidden]right-> ExternalCloud

Backend -[hidden]down-> DbServer
DbServer -[hidden]right-> RedisServer

' ============================================================================
' CONEXÕES LIMPAS (SEM SOBREPOSIÇÕES)
' ============================================================================
' Entrada de Usuário
Client -down..> Nginx : HTTPS :443\n(Acesso Web)

' Distribuição do Gateway
Gateway -down..> Backend : FastCGI :9000\n(/api/v1/*)
Nginx -left..> ProductApi : HTTP :8000\n(/api/products/*)

' Consulta interna entre Backends
Backend -left..> ProductServer : HTTP :8000\n(Consulta de Preços)

' Persistência
LaravelApi -down..> PostgresDB : TCP :5432 (SQL)
Worker -down..> RedisDB : TCP :6379 (Filas)

' Integrações SaaS
Backend -right..> ExternalCloud : HTTPS :443\n(Integrações)

@enduml
